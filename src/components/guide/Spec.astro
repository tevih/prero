---
/**
 * A labelled specimen on the design guide. The `name` is the word the client
 * and the docs use for this element; it is emitted as data-spec so the build
 * tests can check every name is documented in docs/vocabulary.md.
 */
interface Props {
	name: string;
	/** Source file, shown beside the name. */
	where?: string;
	/** One-line note under the specimen. */
	note?: string;
	/** Render the specimen on ink, for elements that live on the dark bands. */
	dark?: boolean;
}
const { name, where, note, dark = false } = Astro.props;
const id = `spec-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class="spec" id={id} data-spec={name}>
	<header class="spec-head">
		<a href={`#${id}`} class="spec-name">{name}</a>
		{where && <code class="spec-where">{where}</code>}
	</header>
	<div class:list={['spec-body', dark && 'spec-dark']}>
		<slot />
	</div>
	{note && <p class="spec-note">{note}</p>}
</section>

<style>
	.spec {
		margin-top: 3rem;
		scroll-margin-top: 5rem;
	}
	.spec-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}
	.spec-name {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		background: var(--color-ink);
		color: var(--color-paper);
		padding: 0.25rem 0.5rem;
		text-decoration: none;
	}
	.spec-name:hover {
		background: var(--color-red);
	}
	.spec-where {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-gray-400);
	}
	.spec-body {
		border: 1px dashed var(--color-gray-300);
		padding: 1.5rem;
		overflow-x: auto;
	}
	.spec-dark {
		background: var(--color-ink);
		color: var(--color-paper);
		border-color: var(--color-gray-700);
	}
	.spec-note {
		margin-top: 0.75rem;
		max-width: 68ch;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-gray-500);
	}
</style>
