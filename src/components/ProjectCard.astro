---
import { Image } from 'astro:assets';
import type { Project } from '../data/work';

interface Props {
	project: Project;
	index: number;
	delay?: number;
}

const { project, index, delay = 0 } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article
	class="group"
	data-reveal
	style={`--reveal-delay:${delay}ms`}
>
	<div class="relative overflow-hidden bg-gray-050">
		<Image
			src={project.image}
			alt={`${project.title} — ${project.client}`}
			widths={[400, 800, 1200]}
			sizes="(min-width: 80rem) 30vw, (min-width: 48rem) 45vw, 92vw"
			class="aspect-[4/3] w-full object-cover grayscale transition-[filter,transform] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03] group-hover:grayscale-0 group-focus-within:grayscale-0"
			loading={index < 3 ? 'eager' : 'lazy'}
		/>
		<span
			class="pointer-events-none absolute inset-0 border border-ink/0 transition-colors duration-500 group-hover:border-ink/10"
			aria-hidden="true"></span>
	</div>

	<div class="mt-4 flex items-baseline gap-4">
		<span class="label text-gray-300 transition-colors duration-300 group-hover:text-red">{num}</span>
		<div class="min-w-0">
			<h3 class="text-base leading-snug font-medium tracking-tight text-balance">{project.title}</h3>
			<p class="mt-1 text-sm text-gray-500">{project.client}</p>
		</div>
	</div>
</article>
