---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Prero">
	<main class="mx-auto flex min-h-full max-w-2xl flex-col justify-center px-6 py-24">
		<p class="text-sm font-medium tracking-widest text-slate-500 uppercase dark:text-slate-400">
			Prero
		</p>
		<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-6xl">
			Something new is being built here.
		</h1>
		<p class="mt-6 max-w-prose text-lg text-slate-600 dark:text-slate-300">
			Astro and Tailwind are wired up and the repo is connected. Replace this page
			whenever you're ready.
		</p>
	</main>
</Layout>
