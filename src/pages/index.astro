---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import headshot from '../assets/headshot.png';
import { projects } from '../data/work';
import { site, origin, facts, bio, services } from '../data/site';

const featured = projects.slice(0, 6);
---

<Base>
	{/* ---------- Hero: the shout ---------- */}
	<section class="field pt-16 pb-20 md:pt-24 md:pb-32">
		<div class="col-span-4 md:col-span-8 xl:col-span-16">
			<div class="flex items-center gap-4" data-reveal>
				<span class="h-2.5 w-2.5 shrink-0 bg-red" aria-hidden="true"></span>
				<p class="label text-gray-500">{site.tagline}</p>
			</div>

			<h1
				class="display mt-8 text-[clamp(3.25rem,15vw,15rem)]"
				data-reveal
				style="--reveal-delay:40ms"
			>
				<span class="block">Gabriel</span>
				<span class="block">Prero</span>
			</h1>
		</div>

		<div class="col-span-4 mt-12 md:col-span-8 xl:col-span-16 xl:mt-16">
			<div class="rule-ink origin-left" data-draw style="--reveal-delay:80ms"></div>
		</div>

		{/* Dense metadata cluster against the void above. */}
		<dl
			class="col-span-4 mt-6 grid grid-cols-2 gap-x-6 gap-y-6 md:col-span-8 md:grid-cols-4 xl:col-span-10 xl:col-start-7"
			data-reveal
			style="--reveal-delay:120ms"
		>
			<div>
				<dt class="label text-gray-400">Discipline</dt>
				<dd class="mt-2 text-sm leading-snug">Industrial Design</dd>
			</div>
			<div>
				<dt class="label text-gray-400">Practice</dt>
				<dd class="mt-2 text-sm leading-snug">Design Leadership</dd>
			</div>
			<div>
				<dt class="label text-gray-400">Based</dt>
				<dd class="mt-2 text-sm leading-snug">Chicago, Illinois</dd>
			</div>
			<div>
				<dt class="label text-gray-400">Since</dt>
				<dd class="mt-2 text-sm leading-snug">2007</dd>
			</div>
		</dl>
	</section>

	{/* ---------- Origin: the alarm clock ---------- */}
	<section class="border-t border-gray-200 bg-ink py-24 text-paper md:py-40">
		<div class="field">
			<p class="label col-span-4 mb-12 text-gray-500 md:col-span-8 xl:col-span-3">
				Why design
			</p>

			<div class="col-span-4 md:col-span-8 xl:col-span-11 xl:col-start-5">
				{
					origin.map((line, i) => {
						const [before, after] = line.accent
							? line.text.split(line.accent)
							: [line.text, null];
						return (
							<p
								class:list={[
									'text-[clamp(1.35rem,3.4vw,2.6rem)] leading-[1.24] font-medium tracking-tight text-balance',
									i > 0 && 'mt-6',
									i === origin.length - 1 ? 'text-paper' : 'text-gray-300',
								]}
								data-reveal
								style={`--reveal-delay:${i * 40}ms`}
							>
								{before}
								{after !== null && (
									<>
										<span class="text-red">{line.accent}</span>
										{after}
									</>
								)}
							</p>
						);
					})
				}
			</div>
		</div>
	</section>

	{/* ---------- Facts ---------- */}
	<section class="field py-20 md:py-28">
		{
			facts.map((fact, i) => (
				<div
					class="col-span-2 md:col-span-2 xl:col-span-4"
					data-reveal
					style={`--reveal-delay:${i * 40}ms`}
				>
					<div class="rule-ink origin-left" data-draw style={`--reveal-delay:${i * 40}ms`} />
					<p class="display mt-4 text-[clamp(2.75rem,7vw,4.5rem)]">{fact.figure}</p>
					<p class="label mt-2 text-gray-500">{fact.label}</p>
				</div>
			))
		}
	</section>

	{/* ---------- Intro + portrait ---------- */}
	<section class="field items-start gap-y-12 pb-24 md:pb-32">
		<div class="col-span-4 md:col-span-3 xl:col-span-5" data-reveal>
			<Image
				src={headshot}
				alt="Portrait of Gabriel Prero"
				widths={[400, 800]}
				sizes="(min-width: 80rem) 30vw, (min-width: 48rem) 36vw, 92vw"
				class="w-full bg-gray-050 object-cover grayscale"
				loading="lazy"
			/>
		</div>

		<div
			class="prose-swiss col-span-4 md:col-span-5 xl:col-span-9 xl:col-start-7"
			data-reveal
			style="--reveal-delay:40ms"
		>
			<p class="text-lg leading-relaxed text-gray-700 md:text-xl">{bio[0]}</p>
			<a
				href="/bio/"
				class="label mt-8 inline-flex items-center gap-3 border-b border-ink pb-1 transition-colors hover:border-red hover:text-red"
			>
				Read the full bio
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</section>

	{/* ---------- Selected work ---------- */}
	<SectionHead index="01" title="Selected work" class="mb-10 md:mb-14" />

	<div class="field gap-y-12 md:gap-y-16">
		{
			featured.map((project, i) => (
				<div class="col-span-4 md:col-span-4 xl:col-span-5">
					<ProjectCard project={project} index={i} delay={(i % 3) * 40} />
				</div>
			))
		}

		<div class="col-span-4 mt-4 md:col-span-8 xl:col-span-16">
			<div class="rule"></div>
			<a
				href="/work/"
				class="label group flex items-center justify-between py-6 transition-colors hover:text-red"
			>
				<span>All {projects.length} projects</span>
				<span class="transition-transform duration-500 group-hover:translate-x-2" aria-hidden="true">
					→
				</span>
			</a>
		</div>
	</div>

	{/* ---------- Capabilities ---------- */}
	<SectionHead index="02" title="Capabilities" class="mt-24 mb-10 md:mt-32 md:mb-14" />

	<div class="field">
		<ul class="col-span-4 md:col-span-8 xl:col-span-16">
			{
				services.map((service, i) => (
					<li
						class="group grid grid-cols-[3rem_1fr] items-baseline gap-4 border-b border-gray-100 py-5 md:grid-cols-[5rem_1fr]"
						data-reveal
						style={`--reveal-delay:${(i % 4) * 40}ms`}
					>
						<span class="label text-gray-300 transition-colors duration-300 group-hover:text-red">
							{String(i + 1).padStart(2, '0')}
						</span>
						<span class="text-base leading-snug tracking-tight text-balance md:text-lg">
							{service}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</Base>
