								<span class="border-b border-gray-200 group-hover:border-red">{p.label}</span><span class="text-gray-300" aria-hidden="true">↗</span>
							</a></p>
						))}
					</div>
				</div>
			</Spec>

			<Spec name="Skills" where="skills, skillsPunchline in site.ts" note="Every skill as a Skill Chip; the last one is struck through and the Skills Punchline sits beneath.">
				<div class="mb-4 flex gap-2"><Tag name="Skill Chip" /><Tag name="Skills Punchline" /></div>
				<ul class="flex flex-wrap gap-x-2 gap-y-3">
					{skills.slice(0, 5).map((s) => <li class="border border-gray-200 px-3 py-2 text-sm tracking-tight text-gray-700">{s}</li>)}
