				<div class="mt-6"><Tag name="Guide Title" /><p class="max-w-[24ch] text-[clamp(1.6rem,4vw,3rem)] leading-[1.06] font-bold tracking-[-0.03em] text-balance">{guide.title}</p></div>
				<div class="mt-6"><Tag name="Guide Subtitle" /><p class="max-w-[68ch] text-lg leading-relaxed text-gray-600">{guide.subtitle}</p></div>
			</Spec>

			<Spec name="Emphasised Line" note="In the preface, one sentence is set large and dark so it lands.">
				<p class="text-[clamp(1.35rem,3vw,2.1rem)] leading-snug font-medium tracking-tight">I’ve been struggling with Depression for around 30 years.</p>
			</Spec>

			<Spec name="Contents List" note="Every tip as a Numbered Row that jumps to it.">
				<ol class="border-t border-ink">
					{tips.slice(0, 3).map((t, i) => (
						<li><a href={`${url('/supporting-mdd/')}#tip-${i + 1}`} class="group grid grid-cols-[3rem_1fr] items-baseline gap-4 border-b border-gray-100 py-4 transition-colors hover:text-red">
							<span class="label text-gray-300 group-hover:text-red">{String(i + 1).padStart(2, '0')}</span>
							<span class="text-base leading-snug tracking-tight">{t.title}</span>
						</a></li>
					))}
				</ol>
			</Spec>

			<Spec name="Tip" where="tips in guide.ts" note="Each tip: an Ink Rule and red Tip Label on the left, the Tip Title and Tip Body on the right. Suggested phrases are a Quoted List; sidenotes are an Aside; the disclaimer is a Note Box.">
				<div class="mb-4 flex flex-wrap gap-2"><Tag name="Tip Label" /><Tag name="Tip Title" /><Tag name="Tip Body" /></div>
				<div class="grid gap-6 md:grid-cols-[10rem_1fr]">
					<div><div class="rule-ink"></div><p class="label mt-3 text-red">Tip 04</p></div>
					<div class="max-w-[68ch]">
						<p class="text-[clamp(1.5rem,3.4vw,2.35rem)] leading-[1.12] font-bold tracking-[-0.03em] text-balance">{tip.title}</p>
						<p class="mt-5 text-base leading-relaxed text-gray-700 md:text-lg">{tip.blocks[0].text}</p>
					</div>
				</div>
			</Spec>

			<Spec name="Crisis Box" note="The last thing on the guide. A red-ruled panel with the 988 lifeline. It stays.">
				<div class="max-w-[68ch] border-l-2 border-red bg-gray-050 p-6 md:p-8">
					<p class="label mb-3 text-gray-500">If you need help now</p>
					<p class="text-base leading-relaxed text-gray-700">In the US, call or text <strong class="font-medium text-ink">988</strong> to reach the Suicide &amp; Crisis Lifeline.</p>
				</div>
			</Spec>

