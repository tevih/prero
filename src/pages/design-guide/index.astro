			<h2 id="bio" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
				07 — Bio page
			</h2>

			<Spec name="Statement" where="bio, bioCoda, bioJoke in site.ts" note="The bio opens with the Statement paragraphs as Lede, then the Industries Paragraph in Body, then the Punchline set large.">
				<div class="mb-4 flex flex-wrap gap-2"><Tag name="Industries Paragraph" /><Tag name="Punchline" /></div>
				<div class="max-w-[68ch]">
					<p class="text-lg leading-relaxed text-gray-700 md:text-xl">{bio[1]}</p>
					<p class="mt-8 text-base leading-relaxed text-gray-600">{bioCoda}</p>
					<p class="mt-8 text-[clamp(1.25rem,2.6vw,1.9rem)] leading-snug font-medium tracking-tight">{bioJoke}</p>
				</div>
			</Spec>

			<Spec name="Experience Row" where="experience in site.ts" note="Role on the left, company on the right, most recent first.">
				<ol class="border-t border-ink">
					{experience.slice(0, 3).map((j) => (
						<li class="grid grid-cols-1 gap-1 border-b border-gray-100 py-5 md:grid-cols-2 md:gap-8">
							<span class="text-base leading-snug font-medium tracking-tight md:text-lg">{j.role}</span>
							<span class="text-sm text-gray-500 md:text-base">{j.org}</span>
						</li>
					))}
				</ol>
			</Spec>

			<Spec name="Credential Row" where="credentials, press in site.ts" note="Education, patents and awards as rows with a small gray square; beside them the Featured-in Links.">
