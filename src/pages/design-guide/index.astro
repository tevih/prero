			<Spec name="Testimonial Card" where="testimonials in site.ts" note="Three across. A Gray Rule on top, the Quote, then the Attribution Name and Attribution Title.">
				<div class="mb-4 flex flex-wrap gap-2"><Tag name="Quote" /><Tag name="Attribution Name" /><Tag name="Attribution Title" /></div>
				<figure class="max-w-md border-t border-gray-200 pt-5">
