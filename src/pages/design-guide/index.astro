---
/**
 * The design guide: every element on the site, rendered with the real CSS
 * and labelled with the name the client and the docs use for it.
 *
 * Hidden from search engines (noindex) and linked from nowhere on the site.
 * Names here must match docs/vocabulary.md — the build tests enforce it.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Spec from '../../components/guide/Spec.astro';
import Tag from '../../components/guide/Tag.astro';
import Swatch from '../../components/guide/Swatch.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import headshot from '../../assets/headshot.png';
import { projects, galleryFor } from '../../data/work';
import { descriptions, projectSites } from '../../data/descriptions';
import { guide, tips, note } from '../../data/guide';
import {
	site,
	nav,
	origin,
	facts,
	bio,
	bioCoda,
	bioJoke,
	services,
	experience,
	credentials,
	press,
	skills,
	skillsPunchline,
	testimonials,
	links,
	contactIntro,
	contactHours,
} from '../../data/site';
import { url } from '../../lib/url';

const sample = projects[0];
const plate = galleryFor(sample.slug)[0];
const lede = descriptions[sample.slug].find((b) => b.type === 'p')?.text ?? '';
const liveSite = Object.values(projectSites)[0];
const tip = tips[3];

const palette = [
	{ token: 'ink', hex: '#0a0a0a', use: 'Text, the origin band, the footer' },
	{ token: 'paper', hex: '#fafafa', use: 'Page background' },
	{ token: 'red', hex: '#e10600', use: 'Accents only. About two per screen.' },
	{ token: 'red-deep', hex: '#b00400', use: 'Red for small text, where contrast needs it' },
	{ token: 'gray-050', hex: '#f2f2f2', use: 'Image placeholders, quiet panels' },
	{ token: 'gray-100', hex: '#e6e6e6', use: 'Hairlines between list rows' },
	{ token: 'gray-200', hex: '#d1d1d1', use: 'Rules, borders, chips' },
	{ token: 'gray-300', hex: '#b4b4b4', use: 'Inactive numerals and arrows' },
	{ token: 'gray-400', hex: '#8f8f8f', use: 'Labels, inactive nav' },
	{ token: 'gray-500', hex: '#6b6b6b', use: 'Secondary text, captions' },
	{ token: 'gray-600', hex: '#4d4d4d', use: 'Quiet body copy' },
	{ token: 'gray-700', hex: '#333333', use: 'Body copy' },
	{ token: 'gray-800', hex: '#1f1f1f', use: 'Rules on ink' },
];

const sections = [
	['foundations', 'Foundations'],
	['frame', 'Site frame'],
	['patterns', 'Shared patterns'],
	['home', 'Home page'],
	['work', 'Work index'],
	['project', 'Project page'],
	['bio', 'Bio page'],
	['contact', 'Contact page'],
	['guide', 'Supporting MDD guide'],
	['not-found', '404 page'],
];
---

<Base
	title="Design guide"
	section="Internal reference — not indexed"
	description="A labelled reference of every element on the site, so changes can be asked for by name."
	noindex
>
	<section class="field pt-16 pb-12 md:pt-24">
		<p class="label col-span-4 mb-8 text-gray-500 md:col-span-8 xl:col-span-16">Internal</p>
		<h1 class="display col-span-4 text-[clamp(3rem,11vw,9rem)] md:col-span-8 xl:col-span-13">
			Design guide
		</h1>
		<div class="col-span-4 mt-10 md:col-span-8 xl:col-span-16">
			<div class="rule-ink"></div>
		</div>
		<p class="col-span-4 mt-6 text-lg leading-relaxed text-gray-700 md:col-span-8 xl:col-span-9">
			Every element on the site, shown with its name. Use the name when asking for a
			change — “make the <strong class="font-medium text-ink">Billboard Eyebrow</strong> say…”
			— and the assistant will know exactly what you mean and where it lives. Names are
			also mapped to source files in <code class="font-mono text-base">docs/vocabulary.md</code>.
		</p>
		<nav class="col-span-4 mt-10 md:col-span-8 xl:col-span-16" aria-label="Guide contents">
			<ol class="flex flex-wrap gap-x-6 gap-y-3">
				{
					sections.map(([id, label], i) => (
						<li>
							<a href={`#${id}`} class="label text-gray-500 transition-colors hover:text-red">
								<span class="text-gray-300">{String(i + 1).padStart(2, '0')}</span> {label}
							</a>
						</li>
					))
				}
			</ol>
		</nav>
	</section>

	<div class="field">
		<div class="col-span-4 md:col-span-8 xl:col-span-16">
			{/* ================================================================ */}
			<h2 id="foundations" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
				01 — Foundations
			</h2>

			<Spec name="Palette" where="src/styles/global.css" note="Red, black, white and grayscale. There is no other colour on the site, and no tint of red.">
				<div class="grid grid-cols-2 gap-x-3 gap-y-6 md:grid-cols-4 xl:grid-cols-7">
					{palette.map((c) => <Swatch {...c} />)}
				</div>
			</Spec>

			<Spec name="Type Styles" where="src/styles/global.css" note="Two typefaces: Inter for everything, IBM Plex Mono for labels and numerals. Sizes are fluid; the exact classes are in docs/design-system.md.">
				<div class="space-y-8">
					<div>
						<Tag name="Display" />
						<p class="display text-[clamp(2.5rem,7vw,6rem)]">Display type</p>
					</div>
					<div>
						<Tag name="Eyebrow" />
						<p class="label text-gray-500">Small mono line above a title — also called a label</p>
					</div>
					<div>
						<Tag name="Lede" />
						<p class="max-w-[68ch] text-lg leading-relaxed text-gray-700 md:text-xl">
							The opening paragraph of a page or a project, set a size larger than body.
						</p>
					</div>
					<div>
						<Tag name="Body" />
						<p class="max-w-[68ch] text-base leading-relaxed text-gray-700 text-pretty md:text-lg">
							Body copy. Inter, gray-700, generous line height, capped at sixty-eight characters
							so a line never runs too long to read comfortably.
						</p>
					</div>
					<div>
						<Tag name="Meta" />
						<p class="text-sm text-gray-500">Secondary detail — a client name, a caption, a date.</p>
					</div>
					<div>
						<Tag name="Mono Numeral" />
						<p class="label text-gray-300">01 &nbsp; 02 &nbsp; 03 &nbsp; 17</p>
					</div>
				</div>
			</Spec>

			<Spec name="Rules" note="Rules are structure. An Ink Rule opens a section or tops a table; a Gray Rule divides inside one; a Hairline sits between list rows.">
				<div class="space-y-8">
					<div><Tag name="Ink Rule" /><div class="rule-ink"></div></div>
					<div><Tag name="Gray Rule" /><div class="rule"></div></div>
					<div><Tag name="Hairline" /><div class="border-t border-gray-100"></div></div>
				</div>
			</Spec>

			<Spec name="The Field" where=".field in global.css" note="Every page sits on this grid: 4 columns on phones, 8 on tablets, 16 on desktop. Content often starts a few columns in and leaves the last column empty on purpose.">
				<div class="grid grid-cols-4 gap-x-3 gap-y-2 md:grid-cols-8 xl:grid-cols-16">
					{Array.from({ length: 16 }, (_, i) => (
						<div class="label bg-gray-100 py-3 text-center text-gray-500">{i + 1}</div>
					))}
				</div>
			</Spec>

			<Spec name="Spacing" note="The unit is 8px. Everything is a multiple of it.">
				<div class="space-y-3">
					{[1, 2, 4, 8, 16].map((n) => (
						<div class="flex items-center gap-4">
							<span class="label w-16 text-gray-400">{n * 8}px</span>
							<div class="h-3 bg-ink" style={`width:${n * 8}px`} />
						</div>
					))}
				</div>
			</Spec>

			<Spec name="Reveal Motion" note="Elements fade in and rise 16px as they scroll into view, staggered 40ms apart. Rules draw in from the left. Under the system’s reduce-motion setting nothing animates.">
				<div class="space-y-4">
					<div class="rule-ink" data-draw></div>
					<p class="text-base text-gray-700" data-reveal>This line revealed as it entered the viewport.</p>
					<p class="text-base text-gray-700" data-reveal style="--reveal-delay:40ms">This one 40ms later.</p>
					<p class="text-base text-gray-700" data-reveal style="--reveal-delay:80ms">And this one 40ms after that.</p>
				</div>
			</Spec>

			{/* ================================================================ */}
			<h2 id="frame" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
				02 — Site frame
			</h2>

			<Spec name="Header Bar" where="src/layouts/Base.astro" note="Sticks to the top of every page. The live one is above; this is a copy for labelling.">
				<div class="mb-4 flex flex-wrap gap-2">
					<Tag name="Wordmark" /><Tag name="Brand Mark" /><Tag name="Main Navigation" /><Tag name="Active Indicator" />
				</div>
				<div class="flex h-14 items-center justify-between border-b border-gray-200 md:h-16">
					<span class="flex items-baseline gap-2">
						<span class="display text-[0.95rem] leading-none md:text-base">Prero</span>
						<span class="h-2 w-2 shrink-0 bg-red" aria-hidden="true"></span>
					</span>
					<nav class="flex gap-6 xl:gap-10" aria-label="Header specimen">
						{nav.map((item, i) => (
							<a href={url(item.href)} class:list={['label relative py-1', i === 1 ? 'text-ink' : 'text-gray-400']}>
								{item.label}
								{i === 1 && <span class="absolute -bottom-px left-0 h-px w-full bg-red" aria-hidden="true" />}
							</a>
						))}
					</nav>
				</div>
			</Spec>

			<Spec name="Mobile Menu" where="src/layouts/Base.astro" note="Below tablet width the navigation collapses behind a Menu Toggle; the panel lists every page as a Menu Row.">
				<div class="mb-4 flex flex-wrap gap-2"><Tag name="Menu Toggle" /><Tag name="Menu Row" /></div>
				<div class="max-w-sm border border-gray-200">
					<div class="flex h-14 items-center justify-between border-b border-gray-200 px-4">
						<span class="display text-[0.95rem]">Prero</span>
						<span class="label text-gray-500">Close</span>
					</div>
					<ul class="divide-y divide-gray-100 px-4 py-2">
						{nav.slice(0, 3).map((item) => (
							<li>
								<a href={url(item.href)} class="label flex items-center justify-between py-4 text-gray-600">
									{item.label}<span class="text-gray-300">→</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</Spec>

			<Spec name="Section Strip" where="Base.astro — the section prop" note="One mono line directly under the header, naming where you are. Optional per page.">
				<div class="border-b border-gray-100 py-2">
					<p class="label text-gray-400">Portfolio — {projects.length} projects</p>
				</div>
			</Spec>

			<Spec name="Skip Link" where="src/layouts/Base.astro" note="Invisible until a keyboard user tabs to it; jumps past the header to the content.">
				<a href="#main" class="label inline-block bg-ink px-4 py-2 text-paper">Skip to content</a>
			</Spec>

			<Spec name="Footer" where="src/layouts/Base.astro" dark note="The live footer is at the bottom of this page. Its parts, from left to right and top to bottom:">
				<div class="mb-6 flex flex-wrap gap-2">
					<Tag name="Footer Billboard" /><Tag name="Footer CTA" /><Tag name="Direct Column" /><Tag name="Pages Column" /><Tag name="Credit Line" />
				</div>
				<p class="display text-4xl md:text-5xl">Let’s make<br />stuff better.</p>
				<a href={url('/contact/')} class="label mt-8 inline-flex items-center gap-3 border-b border-red pb-1 text-paper hover:text-red">
					Start a conversation <span aria-hidden="true">→</span>
				</a>
				<div class="mt-10 grid grid-cols-2 gap-8 md:max-w-md">
					<div>
						<p class="label mb-4 text-gray-500">Direct</p>
						<p class="text-sm text-gray-200">{site.email}</p>
						<p class="mt-2 text-sm text-gray-400">{site.location}</p>
					</div>
					<div>
						<p class="label mb-4 text-gray-500">Pages</p>
						<p class="text-sm text-gray-200">Index</p>
						<p class="mt-2 text-sm text-gray-200">Work</p>
					</div>
				</div>
				<p class="label mt-8 border-t border-gray-800 pt-6 text-gray-500">{site.credit}</p>
			</Spec>

			{/* ================================================================ */}
			<h2 id="patterns" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
				03 — Shared patterns
			</h2>

			<Spec name="Masthead" note="The top of every page: an optional eyebrow, then the title in display type, then an Ink Rule.">
				<div><Tag name="Masthead Eyebrow" /><p class="label text-gray-500">Chicago, Illinois</p></div>
				<div class="mt-6"><Tag name="Masthead Title" /><p class="display text-[clamp(2.5rem,9vw,7rem)]">Say hello</p></div>
				<div class="rule-ink mt-8"></div>
			</Spec>

			<Spec name="Section Head" where="src/components/SectionHead.astro" note="Opens every titled section below a masthead: a rule that draws in, a red Index Numeral, a gray Section Label.">
				<div class="mb-4 flex gap-2"><Tag name="Index Numeral" /><Tag name="Section Label" /></div>
				<div class="rule-ink"></div>
				<div class="flex items-baseline gap-6 pt-3">
					<span class="label text-red">01</span>
					<span class="label text-gray-500">Selected work</span>
				</div>
			</Spec>

			<Spec name="Text Link" note="An inline call to action: mono, underlined in ink, with an arrow. Turns red on hover.">
				<a href={url('/bio/')} class="label inline-flex items-center gap-3 border-b border-ink pb-1 transition-colors hover:border-red hover:text-red">
					Read the full bio <span aria-hidden="true">→</span>
				</a>
			</Spec>

			<Spec name="Arrow Row" note="A full-width link row with an arrow at the far right. Used for “All projects”, the Elsewhere list, and the 404 links.">
				<div class="rule"></div>
				<a href={url('/work/')} class="label group flex items-center justify-between py-6 transition-colors hover:text-red">
					<span>All {projects.length} projects</span>
					<span class="transition-transform duration-500 group-hover:translate-x-2" aria-hidden="true">→</span>
				</a>
			</Spec>

			<Spec name="Numbered Row" note="A zero-padded numeral and a line of text, hairline-divided. Capabilities, services, the guide’s contents.">
				<ul>
					{services.slice(0, 3).map((s, i) => (
						<li class="group grid grid-cols-[3rem_1fr] items-baseline gap-4 border-b border-gray-100 py-5 md:grid-cols-[5rem_1fr]">
							<span class="label text-gray-300 transition-colors group-hover:text-red">{String(i + 1).padStart(2, '0')}</span>
							<span class="text-base leading-snug tracking-tight text-balance md:text-lg">{s}</span>
						</li>
					))}
				</ul>
			</Spec>

			<Spec name="Chip" note="A small bordered item. Skills use plain text; the Elsewhere Chips on the contact page use the mono label style. The last skill is a Struck Chip — the joke.">
				<div class="mb-4 flex gap-2"><Tag name="Struck Chip" /></div>
				<ul class="flex flex-wrap gap-x-2 gap-y-3">
					{skills.slice(0, 4).map((s) => <li class="border border-gray-200 px-3 py-2 text-sm tracking-tight text-gray-700">{s}</li>)}
					<li class="border border-gray-200 px-3 py-2 text-sm tracking-tight text-gray-400 line-through decoration-red decoration-2">{skills.at(-1)}</li>
				</ul>
			</Spec>

			<Spec name="Side Label" note="On long-form pages, a mono label sits in the left column beside the copy: Preface, Why design, Wrapping it up.">
				<div class="grid gap-6 md:grid-cols-[10rem_1fr]">
					<p class="label text-gray-400">Preface</p>
					<p class="max-w-[68ch] text-base leading-relaxed text-gray-700">The copy sits to the right, starting a few columns in.</p>
				</div>
			</Spec>

			<Spec name="Note Box" note="A quiet gray panel for a disclaimer or aside that should not interrupt the reading rhythm.">
				<div class="border border-gray-200 bg-gray-050 p-6 md:p-8">
					<p class="text-base leading-relaxed text-gray-700 text-pretty">{note.slice(0, 160)}…</p>
				</div>
			</Spec>

			<Spec name="Pull Quote" note="One line set large between two Ink Rules. Used once, in the guide.">
				<p class="border-t border-b border-ink py-8 text-[clamp(1.6rem,4vw,2.75rem)] leading-[1.1] font-bold tracking-[-0.03em] text-balance">
					Living with Depression is not a disqualifier.
				</p>
			</Spec>

			<Spec name="Quoted List" note="Suggested phrases, or key factors, with a faint red rule on the left.">
				<ul class="space-y-3 border-l-2 border-red/30 pl-5">
					{tip.blocks.find((b) => b.type === 'list')?.items?.slice(0, 3).map((i) => (
						<li class="text-base leading-relaxed text-gray-700 md:text-lg">{i}</li>
					))}
				</ul>
			</Spec>

			<Spec name="Aside" note="A paragraph set smaller and grayer, indented behind a gray rule — a sidenote inside a passage.">
				<p class="max-w-[68ch] border-l-2 border-gray-200 pl-5 text-base leading-relaxed text-gray-500">
					Quick sidenote: this is how the definition of Depression is set within the guide’s preface.
				</p>
			</Spec>

			{/* ================================================================ */}
			<h2 id="home" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
				04 — Home page
			</h2>

			<Spec name="HP Billboard" where="src/pages/index.astro" note="The first screen of the home page.">
				<div><Tag name="Billboard Eyebrow" />
					<div class="flex items-center gap-4">
						<span class="h-2.5 w-2.5 shrink-0 bg-red" aria-hidden="true"></span>
						<p class="label text-gray-500">{site.tagline}</p>
					</div>
				</div>
				<div class="mt-8"><Tag name="Billboard Name" /><p class="display text-[clamp(3rem,12vw,10rem)]">Gabriel<br />Prero</p></div>
				<div class="mt-10"><Tag name="Billboard Rule" /><div class="rule-ink"></div></div>
				<div class="mt-6"><Tag name="Metadata Cluster" />
					<dl class="grid grid-cols-2 gap-6 md:grid-cols-4">
						{[['Discipline', 'Industrial Design'], ['Practice', 'Design Leadership'], ['Based', 'Chicago, Illinois'], ['Since', '2007']].map(([k, v], i) => (
							<div>
								{i === 0 && <Tag name="Metadata Item" />}
								<dt class="label text-gray-400">{k}</dt>
								<dd class="mt-2 text-sm leading-snug">{v}</dd>
							</div>
						))}
					</dl>
				</div>
			</Spec>

			<Spec name="Origin Band" where="src/pages/index.astro · origin in site.ts" dark note="The alarm-clock story on black. The last line is white; the rest are gray. One word is red — the Accent Word — and there is only ever one.">
				<div class="mb-6 flex flex-wrap gap-2"><Tag name="Origin Side Label" /><Tag name="Origin Line" /><Tag name="Accent Word" /></div>
				<div class="grid gap-8 md:grid-cols-[10rem_1fr]">
					<p class="label text-gray-500">Why design</p>
					<div>
						{origin.slice(-2).map((line, i) => {
							const [before, after] = line.accent ? line.text.split(line.accent) : [line.text, null];
							return (
								<p class:list={['text-[clamp(1.25rem,2.6vw,2rem)] leading-[1.24] font-medium tracking-tight', i > 0 && 'mt-6', i === 1 ? 'text-paper' : 'text-gray-300']}>
									{before}{after !== null && <><span class="text-red">{line.accent}</span>{after}</>}
								</p>
							);
						})}
					</div>
				</div>
			</Spec>

			<Spec name="Facts Strip" where="facts in site.ts" note="Four Fact Tiles in a row. The project count is computed; the others are typed in.">
				<div class="mb-4 flex flex-wrap gap-2"><Tag name="Fact Tile" /><Tag name="Fact Numeral" /><Tag name="Fact Label" /></div>
				<div class="grid grid-cols-2 gap-x-3 gap-y-8 md:grid-cols-4">
					{facts.map((f) => (
						<div>
							<div class="rule-ink"></div>
							<p class="display mt-4 text-[clamp(2.25rem,5vw,3.5rem)]">{f.figure}</p>
							<p class="label mt-2 text-gray-500">{f.label}</p>
						</div>
					))}
				</div>
			</Spec>

			<Spec name="Intro Block" where="bio[0] in site.ts" note="The Portrait beside the first bio paragraph and a Text Link to the full bio.">
				<div class="mb-4 flex flex-wrap gap-2"><Tag name="Portrait" /><Tag name="Intro Paragraph" /></div>
				<div class="grid gap-8 md:grid-cols-[14rem_1fr]">
					<Image src={headshot} alt="Portrait of Gabriel Prero" widths={[400]} sizes="14rem" class="w-full bg-gray-050 object-cover grayscale" loading="lazy" />
					<p class="max-w-[68ch] text-lg leading-relaxed text-gray-700">{bio[0].slice(0, 220)}…</p>
				</div>
			</Spec>

			<Spec name="Selected Work" where="src/pages/index.astro · ProjectCard.astro" note="Six Project Cards, three across, then an Index Link to the full list. Cards are grayscale until hovered. A card’s parts:">
				<div class="mb-6 flex flex-wrap gap-2">
					<Tag name="Project Card" /><Tag name="Card Image" /><Tag name="Card Numeral" /><Tag name="Card Title" /><Tag name="Card Client" /><Tag name="Card Arrow" /><Tag name="Index Link" />
				</div>
				<div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
					{projects.slice(0, 3).map((p, i) => <ProjectCard project={p} index={i} />)}
				</div>
				<div class="rule mt-10"></div>
				<a href={url('/work/')} class="label group flex items-center justify-between py-6 transition-colors hover:text-red">
					<span>All {projects.length} projects</span><span aria-hidden="true">→</span>
				</a>
			</Spec>

			<Spec name="Capabilities" where="services in site.ts" note="A Section Head followed by every service as a Numbered Row. The same list appears on the bio page as “What I can do for you”.">
				<div class="rule-ink"></div>
				<div class="flex items-baseline gap-6 pt-3"><span class="label text-red">02</span><span class="label text-gray-500">Capabilities</span></div>
				<ul class="mt-8">
					{services.slice(0, 2).map((s, i) => (
						<li class="grid grid-cols-[3rem_1fr] items-baseline gap-4 border-b border-gray-100 py-5 md:grid-cols-[5rem_1fr]">
							<span class="label text-gray-300">{String(i + 1).padStart(2, '0')}</span>
							<span class="text-base leading-snug tracking-tight md:text-lg">{s}</span>
						</li>
					))}
				</ul>
			</Spec>

			{/* ================================================================ */}
			<h2 id="work" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
				05 — Work index
			</h2>

			<Spec name="Project Index" where="src/pages/work/index.astro" note="A typographic table of every project, above the images. Each Index Row is a link.">
				<div class="mb-4 flex flex-wrap gap-2"><Tag name="Index Header" /><Tag name="Index Row" /></div>
				<div class="rule-ink"></div>
				<div class="label grid grid-cols-[2.5rem_1fr] gap-4 py-3 text-gray-400 md:grid-cols-[4rem_1fr_10rem_10rem]">
					<span>No.</span><span>Project</span><span class="hidden md:block">Client</span><span class="hidden md:block">Discipline</span>
				</div>
				<ol class="border-t border-gray-200">
					{projects.slice(0, 3).map((p, i) => (
						<li>
							<a href={url(`/work/${p.slug}/`)} class="group grid grid-cols-[2.5rem_1fr] items-baseline gap-4 border-b border-gray-100 py-4 transition-colors hover:text-red md:grid-cols-[4rem_1fr_10rem_10rem]">
								<span class="label text-gray-300 group-hover:text-red">{String(i + 1).padStart(2, '0')}</span>
								<span class="text-base leading-snug font-medium tracking-tight md:text-lg">{p.title}</span>
								<span class="hidden text-sm text-gray-500 md:block">{p.client}</span>
								<span class="hidden text-sm text-gray-500 md:block">{p.discipline}</span>
							</a>
						</li>
					))}
				</ol>
			</Spec>

			<Spec name="Plates Grid" note="Below the index, every project as a Project Card under a Section Head titled “Plates”. Same card as the home page.">
				<div class="rule-ink"></div>
				<div class="flex items-baseline gap-6 pt-3"><span class="label text-red">01</span><span class="label text-gray-500">Plates</span></div>
			</Spec>

			<Spec name="Footnote" note="A small gray line at the foot of the work index explaining the hover behaviour.">
				<p class="border-t border-gray-200 pt-4 text-sm text-gray-500">Select a plate to open the project. Hover or focus to see it in full colour.</p>
			</Spec>

			{/* ================================================================ */}
			<h2 id="project" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
				06 — Project page
			</h2>

			<Spec name="Back Link" where="src/pages/work/[slug].astro">
				<a href={url('/work/')} class="label group inline-flex items-center gap-3 text-gray-400 transition-colors hover:text-red">
					<span aria-hidden="true">←</span> All work
				</a>
			</Spec>

			<Spec name="Project Rule" note="An Ink Rule with the project’s number in red and the client in gray.">
				<div class="mb-4 flex gap-2"><Tag name="Project Numeral" /><Tag name="Client Label" /></div>
				<div class="rule-ink"></div>
				<div class="flex items-baseline gap-6 pt-3"><span class="label text-red">01</span><span class="label text-gray-500">{sample.client}</span></div>
			</Spec>

			<Spec name="Project Title" where="title in work.ts">
				<p class="display text-[clamp(2rem,6vw,5rem)]">{sample.title}</p>
			</Spec>

			<Spec name="Lead Image" where="image in work.ts · src/assets/work/" note="The project’s main image, full width, in colour. The same file is the Card Image, where it is grayscale.">
				<Image src={sample.image} alt={`${sample.title} for ${sample.client}`} widths={[800, 1200]} sizes="(min-width: 80rem) 80vw, 92vw" class="w-full bg-gray-050 object-cover" loading="lazy" />
			</Spec>

			<Spec name="Project Facts" note="Client, Discipline and the plate count, each a Fact Row down the left column.">
				<div class="mb-4 flex gap-2"><Tag name="Fact Row" /></div>
				<dl class="max-w-xs">
					{[['Client', sample.client], ['Discipline', sample.discipline], ['Plates', String(galleryFor(sample.slug).length)]].map(([k, v], i) => (
						<div class:list={['pt-3', i === 0 ? 'border-t border-ink' : 'mt-6 border-t border-gray-200']}>
							<dt class="label text-gray-400">{k}</dt>
							<dd class="mt-2 text-base tracking-tight">{v}</dd>
						</div>
					))}
				</dl>
			</Spec>

			<Spec name="Narrative" where="descriptions.ts" note="The project story. The first paragraph is the Narrative Lede; the rest are Narrative Body; a Bullet List is a red-ruled list; a Product Site Link follows if the product is on sale.">
				<div class="mb-4 flex flex-wrap gap-2"><Tag name="Narrative Lede" /><Tag name="Narrative Body" /><Tag name="Bullet List" /><Tag name="Product Site Link" /></div>
				<div class="max-w-[68ch]">
					<p class="text-[clamp(1.15rem,2.4vw,1.6rem)] leading-snug font-medium tracking-tight">{lede.slice(0, 180)}…</p>
					<p class="mt-5 text-base leading-relaxed text-gray-700 md:text-lg">Following paragraphs read as Body.</p>
					<ol class="mt-6 space-y-4 border-l-2 border-red/30 pl-5">
						<li class="text-base leading-relaxed text-gray-700 md:text-lg">A key factor from the research.</li>
						<li class="text-base leading-relaxed text-gray-700 md:text-lg">Another.</li>
					</ol>
					<a href={liveSite} target="_blank" rel="noopener noreferrer" class="label group mt-8 inline-flex items-center gap-3 border-b border-ink pb-1 transition-colors hover:border-red hover:text-red">
						Visit the product site <span aria-hidden="true">↗</span>
					</a>
				</div>
			</Spec>

			<Spec name="Plate" where="src/assets/projects/<slug>/NN.jpg" note="A gallery image with a Plate Caption counting its position. Every third plate runs full width.">
				<div class="mb-4 flex gap-2"><Tag name="Plate Caption" /></div>
				<figure class="max-w-md">
					<Image src={plate} alt={`${sample.title} — plate 01`} widths={[600]} sizes="28rem" class="w-full bg-gray-050 object-cover" loading="lazy" />
					<figcaption class="label mt-3 text-gray-300">01 / {String(galleryFor(sample.slug).length).padStart(2, '0')}</figcaption>
				</figure>
			</Spec>

			<Spec name="Project Pager" note="Previous and next at the foot of every project. Wraps around at the ends.">
				<nav class="grid grid-cols-2 border-t border-ink pt-6" aria-label="Pager specimen">
					<a href={url(`/work/${projects.at(-1)!.slug}/`)} class="group">
						<span class="label text-gray-400 group-hover:text-red">← Previous</span>
						<p class="mt-2 text-base leading-snug tracking-tight md:text-lg">{projects.at(-1)!.title}</p>
					</a>
					<a href={url(`/work/${projects[1].slug}/`)} class="group text-right">
						<span class="label text-gray-400 group-hover:text-red">Next →</span>
						<p class="mt-2 text-base leading-snug tracking-tight md:text-lg">{projects[1].title}</p>
					</a>
				</nav>
			</Spec>

