				<div class="mt-8"><Tag name="404 Links" />
					<ul class="max-w-md">
						{nav.slice(0, 2).map((item) => (
							<li><a href={url(item.href)} class="group flex items-center justify-between border-b border-gray-100 py-4 transition-colors hover:text-red">
								<span class="text-base tracking-tight md:text-lg">{item.label}</span><span class="text-gray-300" aria-hidden="true">→</span>
							</a></li>
						))}
					</ul>
				</div>
			</Spec>
		</div>
	</div>
</Base>
