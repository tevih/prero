			</Spec>

			<Spec name="Business Hours" where="contactHours in site.ts">
				<p class="label mb-4 text-gray-400">Business hours</p>
				<p class="max-w-[68ch] text-base leading-relaxed text-gray-700">{contactHours}</p>
