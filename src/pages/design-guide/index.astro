					<figcaption class="mt-5">
						<p class="text-sm font-medium tracking-tight">{testimonials[10].name}</p>
						<p class="label mt-1 text-gray-400">{testimonials[10].title}</p>
					</figcaption>
				</figure>
			</Spec>

			<Spec name="Elsewhere Row" where="links in site.ts" note="Social profiles, résumé and stores as Arrow Rows with an outward arrow.">
				<ul class="border-t border-ink">
					{links.slice(0, 3).map((l) => (
						<li><a href={l.href} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between border-b border-gray-100 py-5 transition-colors hover:text-red">
							<span class="text-base tracking-tight md:text-lg">{l.label}</span><span class="text-gray-300 group-hover:text-red" aria-hidden="true">↗</span>
						</a></li>
					))}
				</ul>
			</Spec>

			{/* ================================================================ */}
			<h2 id="contact" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
