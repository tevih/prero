						<li><a href={l.href} target="_blank" rel="noopener noreferrer" class="label inline-block border border-gray-200 px-3 py-2 text-gray-600 transition-colors hover:border-red hover:text-red">{l.label}</a></li>
					))}
				</ul>
			</Spec>

			{/* ================================================================ */}
			<h2 id="guide" class="label mt-20 scroll-mt-24 border-t border-ink pt-3 text-gray-500">
