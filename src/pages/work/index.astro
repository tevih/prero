---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import { projects } from '../../data/work';
import { url } from '../../lib/url';
---

<Base
	title="Work"
	section={`Portfolio — ${projects.length} projects`}
	description="Selected industrial design and product development work by Gabriel Prero — Liberty Hardware, HPI, Catch Co., tag, Swingline, Life Fitness and more."
>
	{/* ---------- Masthead ---------- */}
	<section class="field pt-16 pb-16 md:pt-24 md:pb-24">
		<h1 class="display col-span-4 text-[clamp(3.25rem,14vw,13rem)] md:col-span-8 xl:col-span-16" data-reveal>
			Work
		</h1>
	</section>

	{/* ---------- The index: a typographic table ---------- */}
	<section class="field pb-24 md:pb-32">
		<div class="col-span-4 md:col-span-8 xl:col-span-16">
			<div class="rule-ink origin-left" data-draw></div>

			<div class="label grid grid-cols-[2.5rem_1fr] gap-4 py-3 text-gray-400 md:grid-cols-[4rem_1fr_10rem_10rem]">
				<span>No.</span>
				<span>Project</span>
				<span class="hidden md:block">Client</span>
				<span class="hidden md:block">Discipline</span>
			</div>

			<ol class="border-t border-gray-200">
				{
					projects.map((project, i) => (
						<li data-reveal style={`--reveal-delay:${(i % 4) * 40}ms`}>
							<a
								href={url(`/work/${project.slug}/`)}
								class="group grid grid-cols-[2.5rem_1fr] items-baseline gap-4 border-b border-gray-100 py-4 transition-colors hover:text-red md:grid-cols-[4rem_1fr_10rem_10rem]"
							>
								<span class="label text-gray-300 transition-colors duration-300 group-hover:text-red">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span class="text-base leading-snug font-medium tracking-tight text-balance md:text-lg">
									{project.title}
								</span>
								<span class="hidden text-sm text-gray-500 transition-colors group-hover:text-red md:block">
									{project.client}
								</span>
								<span class="hidden text-sm text-gray-500 transition-colors group-hover:text-red md:block">
									{project.discipline}
								</span>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	{/* ---------- The plates ---------- */}
	<SectionHead index="01" title="Plates" class="mb-10 md:mb-14" />

	<div class="field gap-y-14 md:gap-y-20">
		{
			projects.map((project, i) => (
				<div class="col-span-4 md:col-span-4 xl:col-span-5">
					<ProjectCard project={project} index={i} delay={(i % 3) * 40} />
				</div>
			))
		}
	</div>

	<div class="field mt-20">
		<p class="col-span-4 border-t border-gray-200 pt-4 text-sm text-gray-500 md:col-span-8 xl:col-span-10">
			Select a plate to open the project. Hover or focus to see it in full colour.
		</p>
	</div>
</Base>
