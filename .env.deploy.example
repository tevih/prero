# Copy to .env.deploy (gitignored) and fill in. Mirrors the GitHub secrets.

# From cPanel -> FTP Accounts -> "Configure FTP Client"
FTP_SERVER=ftp.yourdomain.com
FTP_USERNAME=deploy@yourdomain.com
FTP_PASSWORD=

# Relative to the FTP account's home directory.
# If the account's Directory is already public_html/staging, this is just "/".
FTP_REMOTE_DIR=/

# The URL the site will be served from.
SITE_URL=https://yourdomain.com

# Optional overrides
# FTP_PROTOCOL=ftps
# FTP_PORT=21
# FTP_LOG_LEVEL=verbose
